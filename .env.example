# ============================================================
# BASE MEV RESEARCH PLATFORM - CONFIGURATION
# ============================================================

# Network & RPC (Chain ID: 8453)
BASE_CHAIN_ID=8453
BASE_RPC_URL=https://mainnet.base.org
BASE_WS_URL=wss://base-rpc.publicnode.com
BASE_FLASHBLOCKS_WS_URL=

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/base_mev_research?schema=public"

# Execution Boundary (HARD SAFETY CONSTRAINTS - MUST REMAIN DISABLED)
SIMULATION_MODE=true
PAPER_TRADING=true
LIVE_EXECUTION=false

# Paper Trading & Capital Model
STARTING_CAPITAL_USD=10.0
MIN_NET_PROFIT_USD=0.09
MIN_ROI=0.0
MIN_LIQUIDITY_USD=500.0
MAX_SLIPPAGE=0.03
MAX_RISK_SCORE=60.0
MAX_CONCURRENT_SIMULATIONS=100

# Strategy & Exit Configuration
EXIT_MODE=IMMEDIATE
EXIT_AFTER_SWAPS=1
COMPOUNDING=false

# Ingestion & Concurrency
MAX_EVENT_QUEUE_SIZE=50000
INGESTION_BATCH_SIZE=500
DISCOVERY_MODE=HYBRID

# Port Configuration
API_PORT=4000
DASHBOARD_PORT=3000
