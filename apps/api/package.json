{
  "name": "@base-mev/api",
  "version": "1.0.0",
  "description": "Base MEV Research Engine REST & WebSocket API Server",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "node --max-old-space-size=4096 --import tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --test dist/test/*.test.js || tsx --test src/test/*.test.ts"
  },
  "dependencies": {
    "@base-mev/adapters": "*",
    "@base-mev/math-core": "*",
    "@base-mev/research-engine": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
